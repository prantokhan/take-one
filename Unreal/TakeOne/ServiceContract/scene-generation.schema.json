{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takeone.local/schemas/scene-generation-1.0.json",
  "title": "Take One generated scene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "summary",
    "environment",
    "camera",
    "objects"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "camera": {
      "$ref": "#/$defs/camera"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/scene_object"
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "z": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        },
        "z": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        }
      }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitch", "yaw", "roll"],
      "properties": {
        "pitch": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "yaw": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "roll": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ground_color",
        "sky_light_color",
        "sky_light_intensity",
        "sun_color",
        "sun_intensity",
        "sun_rotation",
        "fog_density"
      ],
      "properties": {
        "ground_color": {
          "$ref": "#/$defs/color"
        },
        "sky_light_color": {
          "$ref": "#/$defs/color"
        },
        "sky_light_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "sun_color": {
          "$ref": "#/$defs/color"
        },
        "sun_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sun_rotation": {
          "$ref": "#/$defs/rotation"
        },
        "fog_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "rotation", "fov"],
      "properties": {
        "location": {
          "$ref": "#/$defs/vector"
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        },
        "fov": {
          "type": "number",
          "minimum": 20,
          "maximum": 120
        }
      }
    },
    "scene_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "primitive",
        "location",
        "rotation",
        "scale",
        "color",
        "cast_shadow",
        "asset_hint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "primitive": {
          "enum": ["cube", "sphere", "cylinder", "cone"]
        },
        "location": {
          "$ref": "#/$defs/vector"
        },
        "rotation": {
          "$ref": "#/$defs/rotation"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "cast_shadow": {
          "type": "boolean"
        },
        "asset_hint": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  }
}
